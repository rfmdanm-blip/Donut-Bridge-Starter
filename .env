# Copy these into Railway > your service > Variables.
# Do not commit a real .env file or credentials.
MC_HOST=your-server-address.example
MC_PORT=25565
MC_USERNAME=your-microsoft-account-email@example.com

# Optional: set an exact Minecraft protocol version if autodetection fails.
# Example format: 1.21.4
# MC_VERSION=

# Optional reconnect delay in milliseconds (default 15000)
# RECONNECT_DELAY_MS=15000
